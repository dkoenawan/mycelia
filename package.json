{
  "name": "mycelia",
  "private": true,
  "description": "Workflow runners for the mycelia framework (TypeScript on Node, run through type stripping; see docs/adr/0007).",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
